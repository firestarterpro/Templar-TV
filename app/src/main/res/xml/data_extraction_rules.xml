<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the Jellyfin server key never leaves the TV in a backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="templar_jellyfin.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="templar_jellyfin.xml" />
    </device-transfer>
</data-extraction-rules>
